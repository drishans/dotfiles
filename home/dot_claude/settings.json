{
  "theme": "dark-ansi",
  "statusLine": {
    "type": "command",
    "command": "node -e \"let input='';process.stdin.on('data',chunk=>input+=chunk).on('end',()=>{try{const payload=JSON.parse(input);const model=payload.model?.display_name??'unknown';const used=payload.context_window?.used_percentage;console.log(used==null?model:model+' | ctx: '+Math.round(used)+'% used')}catch{console.log('unknown')}})\""
  }
}